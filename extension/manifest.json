{
  "manifest_version": 3,
  "name": "Browser Messenger",
  "version": "1.0.0",
  "description": "Send messages and URLs between two Chrome browsers.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/loaded.jpg",
      "32": "icons/loaded.jpg",
      "48": "icons/loaded.jpg",
      "128": "icons/loaded.jpg"
    }
  },
  "icons": {
    "16": "icons/loaded.jpg",
    "32": "icons/loaded.jpg",
    "48": "icons/loaded.jpg",
    "128": "icons/loaded.jpg"
  }
}