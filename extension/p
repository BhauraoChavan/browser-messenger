const roomInput = document.getElementById("roomInput");
const connectBtn = document.getElementById("connectBtn");
const disconnectBtn = document.getElementById("disconnectBtn");
const statusElement = document.getElementById("status");
const presenceElement = document.getElementById("presence");
const connectionLogo = document.getElementById("connectionLogo");
const chatSection = document.getElementById("chatSection");
const messagesElement = document.getElementById("messages");
const messageInput = document.getElementById("messageInput");
const sendBtn = document.getElementById("sendBtn");
const shareBtn = document.getElementById("shareBtn");

const URL_PATTERN = /^https?:\/\/\S+$/i;

let friendConnected = false;
let connected = false;
const renderedMessages = new Set();

function setMessagingEnabled(enabled) {
  friendConnected = enabled;
  messageInput.disabled = !enabled;
  sendBtn.disabled = !enabled;
  shareBtn.disabled = !enabled;
}

function applyStatus(status) {
  statusElement.textContent = status;
  connected = status === "Connected";

  connectionLogo.src = connected
    ? "icons/loaded.jpg"
    : "icons/preload.jpg";

  connectBtn.disabled = connected;
  roomInput.disabled = connected;
  disconnectBtn.classList.toggle("hidden", !activeRoom());

  if (!connected) {
    setMessagingEnabled(false);
    presenceElement.textContent = "";
  }
}

function activeRoom() {
  return connectBtn.disabled;
}

function applyPresence() {
  if (!connected) {
    return;
  }

  presenceElement.textContent = friendConnected
    ? "🟢 Friend online"
    : "🟡 Waiting for friend...";
}

chrome.storage.local.get(["roomId"], (result) => {
  if (result.roomId) {
    roomInput.value = result.roomId;
  }
});

chrome.runtime.sendMessage({ type: "getState" }, (state) => {
  if (chrome.runtime.lastError || !state) {
    return;
  }

  applyStatus(state.status);
  setMessagingEnabled(state.friendConnected);
  applyPresence();

  if (state.status === "Connected") {
    chatSection.classList.remove("hidden");
  }

  for (const message of state.messages || []) {
    renderChatMessage(message);
  }

  markFriendMessagesRead(state.messages || []);
});

chrome.runtime.onMessage.addListener((message) => {
  if (message.type === "status") {
    applyStatus(message.status);
    return;
  }

  if (message.type === "serverMessage") {
    handleMessage(message.data);
  }
});

connectBtn.addEventListener("click", () => {
  const roomId = roomInput.value.trim();

  if (!roomId) {
    alert("Please enter a Room ID.");
    return;
  }

  chrome.storage.local.set({ roomId });
  applyStatus("Connecting...");
  setMessagingEnabled(false);
  chrome.runtime.sendMessage({ type: "connect", roomId });
});

disconnectBtn.addEventListener("click", () => {
  chrome.runtime.sendMessage({ type: "disconnect" });
  applyStatus("Disconnected");
});

sendBtn.addEventListener("click", () => sendMessage("text"));

shareBtn.addEventListener("click", () => {
  chrome.tabs.query({ active: true, currentWindow: true }, (tabs) => {
    const url = tabs?.[0]?.url;

    if (!url || !URL_PATTERN.test(url)) {
      alert("No shareable tab URL found.");
      return;
    }

    sendMessage("url", url);
  });
});

messageInput.addEventListener("keydown", (event) => {
  if (event.key === "Enter") {
    sendMessage("text");
  }
});

function handleMessage(data) {
  if (data.type === "joined") {
    chatSection.classList.remove("hidden");
    setMessagingEnabled(data.users >= 2);
    addSystemMessage(`Joined room: ${data.roomId}`);

    if (data.users === 1) {
      addSystemMessage("Waiting for your friend...");
    }
    return;
  }

  if (data.type === "user-joined") {
    setMessagingEnabled(true);
    applyPresence();
    addSystemMessage("Your friend joined the room 🟢");
    return;
  }

  if (data.type === "user-left") {
    setMessagingEnabled(false);
    applyPresence();
    addSystemMessage("Your friend left the room 🔴");
    return;
  }

  if (data.type === "message" || data.type === "message-sent") {
    const wasNew = !renderedMessages.has(data.messageId);
    renderChatMessage(data);

    if (wasNew && data.type === "message" && !data.mine) {
      chrome.runtime.sendMessage({
        type: "markRead",
        messageIds: [data.messageId],
      });
    }
    return;
  }

  if (data.type === "message-status") {
    updateMessageStatus(data.messageId, data.status);
    return;
  }

  if (data.type === "error") {
    alert(data.message);
  }
}

function sendMessage(messageType, presetText) {
  const text = (presetText ?? messageInput.value).trim();

  if (!text) {
    return;
  }

  if (!friendConnected) {
    addSystemMessage("Waiting for your friend to join...");
    return;
  }

  chrome.runtime.sendMessage(
    { type: "send", text, messageType },
    (response) => {
      if (chrome.runtime.lastError || !response || !response.ok) {
        alert(response?.error || "Not connected.");
        return;
      }

      if (presetText === undefined) {
        messageInput.value = "";
      }
    },
  );
}

function renderChatMessage(message) {
  if (!message.messageId || renderedMessages.has(message.messageId)) {
    return;
  }

  renderedMessages.add(message.messageId);

  const isMine = Boolean(message.mine);
  const div = document.createElement("div");
  div.className = `message ${isMine ? "mine" : "friend"}`;
  div.dataset.messageId = message.messageId;

  const text = document.createElement("span");
  text.className = "messageText";
  text.textContent = `${isMine ? "You" : "Friend"}: `;
  div.appendChild(text);

  if (message.messageType === "url" || URL_PATTERN.test(message.text || "")) {
    const link = document.createElement("a");
    link.href = message.text;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.textContent = message.text;
    div.appendChild(link);
  } else {
    text.textContent += message.text;
  }

  if (isMine) {
    const status = document.createElement("span");
    status.className = "messageStatus";
    status.textContent = "✓";
    div.appendChild(status);
  }

  const time = document.createElement("span");
  time.className = "messageTime";
  time.textContent = new Date(message.createdAt || Date.now())
    .toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
  div.appendChild(time);

  messagesElement.appendChild(div);
  messagesElement.scrollTop = messagesElement.scrollHeight;
}

function updateMessageStatus(messageId, status) {
  const messageElement = messagesElement.querySelector(
    `[data-message-id="${CSS.escape(messageId)}"]`,
  );

  if (!messageElement) {
    return;
  }

  const statusElement = messageElement.querySelector(".messageStatus");
  if (!statusElement) {
    return;
  }

  if (status === "read") {
    statusElement.textContent = "✓✓";
    statusElement.classList.add("read");
  } else if (status === "delivered") {
    statusElement.textContent = "✓✓";
    statusElement.classList.remove("read");
  } else {
    statusElement.textContent = "✓";
    statusElement.classList.remove("read");
  }
}

function markFriendMessagesRead(messages) {
  const messageIds = messages
    .filter((message) => !message.mine && message.messageId)
    .map((message) => message.messageId);

  if (messageIds.length) {
    chrome.runtime.sendMessage({ type: "markRead", messageIds });
  }
}

function addSystemMessage(text) {
  const div = document.createElement("div");
  div.className = "message system";
  div.textContent = text;
  messagesElement.appendChild(div);
  messagesElement.scrollTop = messagesElement.scrollHeight;
}